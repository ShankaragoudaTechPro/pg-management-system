# Local Docker configuration
# Never commit this .env file to GitHub.

DB_HOST=db
DB_PORT=3306
DB_NAME=pg_management
DB_USERNAME=root
DB_PASSWORD=root

# Replace this with a long, randomly generated secret.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

SERVER_PORT=8080
FRONTEND_PORT=4000

# MySQL root password for Docker initialization
MYSQL_ROOT_PASSWORD=root